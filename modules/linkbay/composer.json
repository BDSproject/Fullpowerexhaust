{
    "name": "linkbay/linkbay",
    "description": "Connects PrestaShop to eBay: import active listings and synchronize stock bidirectionally.",
    "type": "prestashop-module",
    "version": "1.0.0",
    "license": "AFL-3.0",
    "authors": [
        {
            "name": "Boisdur-Salbris Matthieu",
            "role": "Developer"
        },
        {
            "name": "Beassisted",
            "role": "Company"
        }
    ],
    "autoload": {
        "psr-4": {
            "LinkBay\\": "src/"
        }
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "prestashop/php-dev-tools": "^5.0",
        "phpstan/phpstan": "^1.12",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "config": {
        "preferred-install": "dist",
        "prepend-autoloader": false,
        "sort-packages": true,
        "platform-check": false
    }
}
