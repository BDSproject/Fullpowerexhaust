# ── Dépendances (réinstallables) ──
/vendor/
node_modules/

# ── Cache, logs, sessions ──
/var/
/cache/
*.log
/var/logs/

# ── Configuration sensible (identifiants DB, secrets) ──
/app/config/parameters.php
/app/config/parameters.yml
/app/config/parameters.php.prod-bak
/.env
/.env.local

# ── Données boutique (images produit uploadées, logo, etc.) ──
/img/
/upload/
/download/

# ── Packs de langue téléchargés (réinstallables) ──
/translations/*.zip

# ── Fichiers macOS / temporaires ──
.DS_Store
**/.DS_Store
Thumbs.db

# ── Sitemaps générés (reconstruits en production avec le bon domaine) ──
/1_*_sitemap.xml

# ── Fichiers de déploiement / dumps (ne jamais committer) ──
/parameters.php
/parameters-production.php
*.sql
!deploy/*.sql
/dump.sql
